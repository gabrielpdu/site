# --- Área do Cliente (login Google + ordens de serviço) ---------------------
# Banco: em produção, a URL do Postgres Neon (postgresql://...).
# No dev local, deixe um caminho de pasta para usar o PGlite (Postgres embutido,
# sem criar conta): ex. .data/pglite
DATABASE_URL=.data/pglite

# Gere um valor aleatório forte (ex.: openssl rand -base64 32). Nunca versione o valor real.
BETTER_AUTH_SECRET=
# URL pública do site (dev: http://localhost:4321).
BETTER_AUTH_URL=http://localhost:4321

# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mails (Google) da equipe com acesso ao painel /admin, separados por vírgula.
ADMIN_EMAILS=
