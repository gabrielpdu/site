---
interface Props {
  id: string;
  title: string;
  description: string;
  turnaround: string;
  priceRange: string;
  iconType?: string;
  features: string[];
}

const { id, title, description, turnaround, priceRange, iconType = 'gear', features } = Astro.props;
---

<div class="card service-card">
  <div class="card-icon card-icon-orange">
    {iconType === 'mobile' && (
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
        <line x1="12" y1="18" x2="12.01" y2="18"></line>
      </svg>
    )}
    {iconType === 'laptop' && (
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="3" width="20" height="14" rx="2"></rect>
        <line x1="2" y1="20" x2="22" y2="20"></line>
      </svg>
    )}
    {iconType === 'disc' && (
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
    )}
    {iconType === 'database' && (
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
      </svg>
    )}
    {iconType === 'screen' && (
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
        <line x1="8" y1="12" x2="16" y2="12"></line>
      </svg>
    )}
    {iconType === 'gear' && (
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
    )}
  </div>

  <h3 class="service-title">{title}</h3>
  <p class="service-desc">{description}</p>

  <div class="service-meta">
    <div class="meta-tag">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span>Prazo: {turnaround}</span>
    </div>
    <div class="meta-tag price-tag">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="1" x2="12" y2="23"></line>
        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
      </svg>
      <span>Faixa: {priceRange}</span>
    </div>
  </div>

  <ul class="service-features">
    {features.map((feat) => (
      <li>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--ct-green-500)" stroke-width="3">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>{feat}</span>
      </li>
    ))}
  </ul>

  <button 
    type="button" 
    class="btn btn-outline detail-btn" 
    onclick={`document.getElementById('modal-${id}').showModal()`}
    aria-haspopup="dialog"
  >
    <span>Ver Detalhes do Serviço</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </button>
</div>

<style>
  .service-card {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .service-title {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--ct-text-main);
  }

  .service-desc {
    color: var(--ct-text-muted);
    font-size: 0.925rem;
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .service-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: var(--ct-surface);
    padding: 0.75rem 1rem;
    border-radius: var(--ct-radius-sm);
    border: 1px solid var(--ct-border);
    margin-bottom: 1.25rem;
    font-size: 0.85rem;
  }

  .meta-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ct-text-muted);
  }

  .price-tag {
    color: var(--ct-orange-400);
    font-weight: 700;
  }

  .service-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--ct-text-main);
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .service-features li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .detail-btn {
    width: 100%;
    justify-content: space-between;
    font-size: 0.9rem;
    padding: 0.65rem 1rem;
  }
</style>
