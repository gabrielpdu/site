---
const testimonials = [
  {
    name: "Dr. Rodrigo Alencar",
    role: "Advogado Tributarista",
    text: "Meu notebook parou com todos os processos da semana. A CamargoTech recuperou a placa-mãe em menos de 24 horas sem perder um único arquivo. Atendimento e honestidade impecáveis!",
    rating: 5,
    tag: "Recuperação de Notebook Dell"
  },
  {
    name: "Juliana Rocha",
    role: "Designer Gráfica",
    text: "Troquei a tela e bateria do meu iPhone 13. O aparelho voltou novo, com vedação perfeita e garantia por escrito. O sistema de acompanhamento da OS é fantástico!",
    rating: 5,
    tag: "Troca de Tela iPhone"
  },
  {
    name: "Marcos Vinicius",
    role: "Streamer & Desenvolvedor",
    text: "Meu PC Gamer estava superaquecendo e travando. Fizeram delid, troca da pasta térmica por metal líquido e revisão completa do water cooler. A temperatura caiu 25°C!",
    rating: 5,
    tag: "Otimização de PC Gamer"
  },
  {
    name: "Patrícia Menezes",
    role: "Diretora de Operações",
    text: "Contratamos a CamargoTech para fazer a manutenção preventiva de 18 computadores do nosso escritório. Pontuais, profissionais e organizados. Recomendo de olhos fechados!",
    rating: 5,
    tag: "Manutenção Corporativa"
  }
];
---

<section class="section" id="depoimentos">
  <div class="container">
    <div class="section-head">
      <span class="badge badge-green">Clientes Satisfeitos</span>
      <h2>O Que Falam Sobre a CamargoTech</h2>
      <p>Mais de 5.800 clientes atendidos com índice de 99.4% de aprovação e satisfação.</p>
    </div>

    <!-- Testimonials Native Web Component / Container -->
    <div class="testimonials-wrapper" x-data="{ current: 0, total: 4, timer: null }" x-init="timer = setInterval(() => current = (current + 1) % total, 4500)" @mouseenter="clearInterval(timer)" @mouseleave="timer = setInterval(() => current = (current + 1) % total, 4500)">
      <div class="testimonial-cards-grid">
        {testimonials.map((t, idx) => (
          <div 
            class="testimonial-card"
            x-show={`current === ${idx}`}
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 translate-x-4"
            x-transition:enter-end="opacity-100 translate-x-0"
            x-cloak
          >
            <div class="stars-row" aria-label="Avaliação 5 estrelas">
              {"★".repeat(t.rating)}
            </div>
            <p class="quote-text">"{t.text}"</p>
            <div class="quote-author">
              <div class="author-avatar">{t.name.charAt(0)}</div>
              <div class="author-meta">
                <strong>{t.name}</strong>
                <span>{t.role}</span>
                <span class="badge badge-orange" style="margin-top: 4px; font-size: 0.75rem;">{t.tag}</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Controls -->
      <div class="carousel-controls">
        <button 
          type="button" 
          class="ctrl-btn" 
          @click="current = (current - 1 + total) % total" 
          aria-label="Depoimento anterior"
        >
          ‹
        </button>

        <div class="carousel-dots">
          {testimonials.map((_, i) => (
            <button 
              type="button" 
              class="dot-indicator" 
              :class={`{ 'active': current === ${i} }`} 
              @click={`current = ${i}`}
              aria-label={`Ver depoimento ${i + 1}`}
            ></button>
          ))}
        </div>

        <button 
          type="button" 
          class="ctrl-btn" 
          @click="current = (current + 1) % total" 
          aria-label="Próximo depoimento"
        >
          ›
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-wrapper {
    max-width: 820px;
    margin: 0 auto;
  }

  .testimonial-card {
    background: var(--ct-surface-card);
    border: 1px solid var(--ct-border);
    border-radius: var(--ct-radius-lg);
    padding: 2.75rem;
    box-shadow: var(--ct-shadow-md);
    text-align: center;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .stars-row {
    color: #FFB800;
    font-size: 1.5rem;
    letter-spacing: 2px;
    margin-bottom: 1.25rem;
  }

  .quote-text {
    font-size: 1.2rem;
    font-style: italic;
    color: var(--ct-text-main);
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .quote-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-align: left;
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--ct-blue-500), var(--ct-orange-500));
    color: #fff;
    font-weight: 800;
    font-size: 1.2rem;
    display: grid;
    place-items: center;
  }

  .author-meta {
    display: flex;
    flex-direction: column;
  }

  .author-meta strong {
    color: var(--ct-text-main);
    font-size: 1rem;
  }

  .author-meta span {
    color: var(--ct-text-muted);
    font-size: 0.85rem;
  }

  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  .ctrl-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--ct-surface);
    border: 1px solid var(--ct-border);
    color: var(--ct-text-main);
    font-size: 1.6rem;
    display: grid;
    place-items: center;
    transition: var(--ct-transition);
  }

  .ctrl-btn:hover {
    border-color: var(--ct-orange-500);
    color: var(--ct-orange-500);
  }

  .carousel-dots {
    display: flex;
    gap: 0.6rem;
  }

  .dot-indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ct-border);
    border: none;
    transition: var(--ct-transition);
  }

  .dot-indicator.active {
    background: var(--ct-orange-500);
    width: 28px;
    border-radius: var(--ct-radius-full);
  }

  @media (max-width: 600px) {
    .testimonial-card {
      padding: 1.75rem;
    }
    .quote-text {
      font-size: 1rem;
    }
  }
</style>
