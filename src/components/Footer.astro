---
const currentYear = new Date().getFullYear();
---

<footer class="ct-footer">
  <div class="container footer-grid">
    <!-- Brand Info -->
    <div class="footer-col brand-col">
      <div class="footer-logo">
        <span class="logo-camargo">Camargo</span><span class="logo-tech">Tech</span>
      </div>
      <p class="brand-tagline">"Tecnologia consertada com confiança"</p>
      <p class="brand-desc">
        Assistência técnica especializada em notebooks, smartphones, computadores gamers e recuperação de dados com garantia e laudo detalhado.
      </p>
      <div class="social-links">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram da CamargoTech">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook da CamargoTech">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>
        <a href="https://wa.me/5544988424935" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp CamargoTech">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Quick Links -->
    <div class="footer-col">
      <h3 class="footer-title">Navegação</h3>
      <ul class="footer-list">
        <li><a href="/">Página Inicial</a></li>
        <li><a href="/servicos">Todos os Serviços</a></li>
        <li><a href="/sobre">História e Garantia</a></li>
        <li><a href="/area-cliente">Acompanhar Ordem de Serviço</a></li>
        <li><a href="/contato">Solicitar Orçamento Grátis</a></li>
      </ul>
    </div>

    <!-- Services -->
    <div class="footer-col">
      <h3 class="footer-title">Especialidades</h3>
      <ul class="footer-list">
        <li><a href="/servicos#celulares">Conserto de Celulares</a></li>
        <li><a href="/servicos#notebooks">Notebooks e Desktops</a></li>
        <li><a href="/servicos#telas">Troca de Telas e Baterias</a></li>
        <li><a href="/servicos#dados">Recuperação de Arquivos</a></li>
        <li><a href="/servicos#upgrades">Upgrades de SSD e Memória</a></li>
      </ul>
    </div>

    <!-- Contact & Hours -->
    <div class="footer-col">
      <h3 class="footer-title">Atendimento</h3>
      <p class="contact-line"><strong>E-mail:</strong> techcamargo@techcamargo.com.br</p>
      <p class="contact-line"><strong>WhatsApp:</strong> (44) 98842-4935</p>
      <p class="contact-line"><strong>Endereço:</strong> Rua das Tecnologias, 500 - Centro</p>
      <p class="contact-line"><strong>Horário:</strong> Seg a Sex 08:30 – 18:30 | Sáb 09:00 – 13:00</p>
      <div class="lgpd-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>Em conformidade com a LGPD</span>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="footer-bottom">
    <div class="container bottom-content">
      <p>© {currentYear} <strong>CamargoTech</strong> — Todos os direitos reservados. CNPJ: 00.000.000/0001-00</p>
      <div class="legal-links">
        <a href="/politica-privacidade">Política de Privacidade</a>
        <span class="sep">•</span>
        <a href="/termos">Termos de Serviço</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .ct-footer {
    background: var(--ct-blue-900);
    border-top: 1px solid var(--ct-border);
    color: var(--ct-text-muted);
    padding-top: 4.5rem;
    font-size: 0.95rem;
  }

  [data-theme="light"] .ct-footer {
    background: #0d1e30;
    color: #a4b7cc;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.25fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  .footer-logo {
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .logo-camargo {
    color: #FFFFFF;
  }

  .logo-tech {
    color: var(--ct-orange-500);
  }

  .brand-tagline {
    color: var(--ct-orange-400);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .brand-desc {
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-links a {
    width: 38px;
    height: 38px;
    border-radius: var(--ct-radius-sm);
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    display: grid;
    place-items: center;
    transition: var(--ct-transition);
  }

  .social-links a:hover {
    background: var(--ct-orange-500);
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  .footer-title {
    color: #FFFFFF;
    font-size: 1.15rem;
    margin-bottom: 1.25rem;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-list a {
    color: var(--ct-text-muted);
  }

  .footer-list a:hover {
    color: var(--ct-orange-400);
    padding-left: 4px;
  }

  .contact-line {
    margin-bottom: 0.6rem;
    line-height: 1.5;
  }

  .contact-line strong {
    color: #FFFFFF;
  }

  .lgpd-badge {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border-radius: var(--ct-radius-full);
    background: rgba(20, 184, 122, 0.15);
    color: var(--ct-green-400);
    font-size: 0.8rem;
    border: 1px solid rgba(20, 184, 122, 0.3);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: 1.5rem;
    font-size: 0.875rem;
  }

  .bottom-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .legal-links a:hover {
    color: #FFFFFF;
  }

  .sep {
    opacity: 0.4;
  }

  @media (max-width: 990px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media (max-width: 580px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .bottom-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
