---
const phoneNumber = "5544988424935";
const message = "Olá! Vim pelo site da CamargoTech e gostaria de um orçamento para o meu equipamento.";
const waLink = `https://api.whatsapp.com/send?phone=${phoneNumber}&text=${encodeURIComponent(message)}`;
---

<a 
  href={waLink} 
  target="_blank" 
  rel="noopener noreferrer" 
  class="float-wa-btn" 
  aria-label="Fale conosco diretamente pelo WhatsApp"
>
  <span class="wa-tooltip">Atendimento Online</span>
  <div class="wa-icon-wrapper">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/>
    </svg>
  </div>
</a>

<style>
  .float-wa-btn {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 950;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .wa-icon-wrapper {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #25D366, #128C7E);
    color: #FFFFFF;
    display: grid;
    place-items: center;
    box-shadow: 0 10px 25px rgba(37, 211, 102, 0.45);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .float-wa-btn:hover .wa-icon-wrapper {
    transform: scale(1.1);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.6);
  }

  .wa-tooltip {
    background: var(--ct-surface-card);
    border: 1px solid var(--ct-border);
    color: var(--ct-text-main);
    padding: 0.45rem 0.85rem;
    border-radius: var(--ct-radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    box-shadow: var(--ct-shadow-md);
    opacity: 0;
    transform: translateX(10px);
    transition: var(--ct-transition);
    pointer-events: none;
  }

  .float-wa-btn:hover .wa-tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 600px) {
    .float-wa-btn {
      bottom: 1.25rem;
      right: 1.25rem;
    }
    .wa-icon-wrapper {
      width: 52px;
      height: 52px;
    }
    .wa-tooltip {
      display: none;
    }
  }
</style>
