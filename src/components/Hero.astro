---
---

<section class="hero-section">
  <!-- Glowing Background Orbs -->
  <div class="glow-bg glow-blue" style="top: -150px; left: -100px;"></div>
  <div class="glow-bg glow-orange" style="bottom: -150px; right: -50px;"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="badge badge-orange">
        <span class="pulse-dot"></span>
        <span>Assistência Técnica Certificada</span>
      </div>

      <h1 class="hero-title">
        Camargo<span class="gradient-text-orange">Tech</span> — Assistência Técnica Especializada
      </h1>

      <p class="hero-subtitle">
        Reparos rápidos com peças originais, 90 dias de garantia por escrito e laudo técnico transparente. Cuidamos do seu celular, notebook ou PC com a máxima segurança dos seus arquivos.
      </p>

      <div class="hero-ctas">
        <a href="/contato" class="btn btn-primary hero-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>Solicitar Orçamento Grátis</span>
        </a>

        <a href="https://wa.me/5544988424935" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp hero-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/>
          </svg>
          <span>Falar no WhatsApp</span>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="hero-trust">
        <div class="trust-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ct-green-500)" stroke-width="2.5">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
          <span>Diagnóstico Transparente</span>
        </div>
        <div class="trust-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ct-green-500)" stroke-width="2.5">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
          <span>90 Dias de Garantia</span>
        </div>
        <div class="trust-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ct-green-500)" stroke-width="2.5">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
          <span>Dados 100% Protegidos</span>
        </div>
      </div>
    </div>

    <!-- Live Status Card / Demonstration -->
    <div class="hero-visual">
      <div class="status-board">
        <div class="board-header">
          <div class="board-title-group">
            <span class="board-dot"></span>
            <h3>Monitor em Tempo Real — Laboratório CamargoTech</h3>
          </div>
          <span class="badge badge-green">Atualizado agora</span>
        </div>

        <div class="board-items">
          <div class="board-item">
            <div class="item-meta">
              <strong>Notebook Dell G15</strong>
              <span>Troca pasta térmica + Limpeza ultrassônica</span>
            </div>
            <span class="pill-status pill-ready">Pronto para Retirada</span>
          </div>

          <div class="board-item">
            <div class="item-meta">
              <strong>iPhone 13 Pro Max</strong>
              <span>Substituição tela OLED original</span>
            </div>
            <span class="pill-status pill-testing">Testes Finais</span>
          </div>

          <div class="board-item">
            <div class="item-meta">
              <strong>PC Gamer Core i9 + RTX 4080</strong>
              <span>Reparo em trilha de alimentação VRM</span>
            </div>
            <span class="pill-status pill-repair">Em Reparo</span>
          </div>

          <div class="board-item">
            <div class="item-meta">
              <strong>MacBook Air M1</strong>
              <span>Substituição de bateria interna original</span>
            </div>
            <span class="pill-status pill-approval">Aguardando Aprovação</span>
          </div>
        </div>

        <!-- Live Metrics / Counters -->
        <div class="board-counters" id="metrics-counters">
          <div class="counter-box">
            <span class="counter-num" data-target="5800">+5.800</span>
            <span class="counter-label">Aparelhos Reparados</span>
          </div>
          <div class="counter-box">
            <span class="counter-num" data-target="12">12</span>
            <span class="counter-label">Anos de Atuação</span>
          </div>
          <div class="counter-box">
            <span class="counter-num" data-target="4.9">4.9 ★</span>
            <span class="counter-label">Avaliação Google</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-block: 6rem 5rem;
    overflow: hidden;
    background: radial-gradient(circle at 10% 20%, rgba(30, 111, 191, 0.12) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(255, 107, 26, 0.08) 0%, transparent 40%);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ct-orange-500);
    box-shadow: 0 0 0 4px rgba(255, 107, 26, 0.25);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(255, 107, 26, 0.4); }
    70% { box-shadow: 0 0 0 8px rgba(255, 107, 26, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 107, 26, 0); }
  }

  .hero-title {
    margin-top: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--ct-text-muted);
    line-height: 1.65;
    margin-bottom: 2.25rem;
    max-width: 620px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .hero-btn {
    padding: 0.95rem 1.85rem;
    font-size: 1.05rem;
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    color: var(--ct-text-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Status Board Card */
  .status-board {
    background: var(--ct-surface-card);
    border: 1px solid var(--ct-border);
    border-radius: var(--ct-radius-lg);
    padding: 2rem;
    box-shadow: var(--ct-shadow-lg);
    position: relative;
  }

  .board-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--ct-border);
  }

  .board-title-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .board-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ct-green-500);
    box-shadow: 0 0 8px var(--ct-green-500);
  }

  .board-title-group h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ct-text-main);
  }

  .board-items {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: 1.75rem;
  }

  .board-item {
    background: var(--ct-surface);
    border: 1px solid var(--ct-border);
    border-radius: var(--ct-radius-sm);
    padding: 0.95rem 1.15rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    transition: var(--ct-transition);
  }

  .board-item:hover {
    border-color: var(--ct-blue-500);
  }

  .item-meta {
    display: flex;
    flex-direction: column;
  }

  .item-meta strong {
    font-size: 0.925rem;
    color: var(--ct-text-main);
  }

  .item-meta span {
    font-size: 0.8rem;
    color: var(--ct-text-muted);
  }

  .pill-status {
    padding: 0.3rem 0.75rem;
    border-radius: var(--ct-radius-full);
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .pill-ready {
    background: rgba(20, 184, 122, 0.15);
    color: var(--ct-green-400);
  }

  .pill-testing {
    background: rgba(30, 111, 191, 0.15);
    color: var(--ct-blue-300);
  }

  .pill-repair {
    background: rgba(255, 107, 26, 0.15);
    color: var(--ct-orange-400);
  }

  .pill-approval {
    background: rgba(255, 184, 0, 0.15);
    color: var(--ct-warning);
  }

  .board-counters {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ct-border);
    text-align: center;
  }

  .counter-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .counter-num {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--ct-orange-500);
  }

  .counter-label {
    font-size: 0.75rem;
    color: var(--ct-text-muted);
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
