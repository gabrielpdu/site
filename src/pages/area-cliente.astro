---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Área do Cliente & Acompanhamento de OS | CamargoTech" 
  description="Consulte o andamento da sua ordem de serviço em tempo real. Veja laudo técnico, testes realizados e previsão de entrega do seu equipamento."
  activePage="area-cliente"
>
  <div class="section-head" style="padding-top: 4rem;">
    <span class="badge badge-orange">Portal de Transparência</span>
    <h1>Área do Cliente CamargoTech</h1>
    <p>Acompanhe cada etapa do diagnóstico e conserto do seu dispositivo com total clareza.</p>
  </div>

  <section class="container" style="max-width: 900px; margin-bottom: 5rem;" x-data="{
    // Dados FICTÍCIOS de demonstração — não há integração com o sistema real de OS.
    demos: {
      'CT-2024-001': {
        id: 'CT-2024-001',
        cliente: 'Cliente Exemplo A',
        aparelho: 'Notebook Dell Inspiron 15',
        defeito: 'Superaquecimento, desligamento repentino e lentidão no boot',
        status: 'Em Reparo',
        percentual: 65,
        dataEntrada: '25/09/2026',
        previsao: '28/09/2026',
        tecnico: 'Eng. Lucas Camargo (CREA/CFT)',
        laudo: 'Identificado acúmulo severo de poeira e ressecamento total da pasta térmica original. Foi executada a desoxidação ultrassônica dos coolers e aplicação de pasta térmica de prata Arctic MX-4. Realizado upgrade para SSD NVMe 512GB com clonagem do Windows.',
        valor: 'R$ 280,00',
        historico: [
          { data: '25/09 09:30', evento: 'Equipamento recebido na recepção e gerada OS' },
          { data: '25/09 14:15', evento: 'Diagnóstico de bancada concluído e orçamento emitido' },
          { data: '25/09 15:40', evento: 'Orçamento aprovado pelo cliente via WhatsApp' },
          { data: '26/09 10:20', evento: 'Desmontagem, higienização interna e aplicação de pasta térmica concluída' },
          { data: '26/09 16:00', evento: 'Em andamento: Teste de estresse térmico no AIDA64 e clonagem do disco' }
        ]
      },
      'CT-2024-002': {
        id: 'CT-2024-002',
        cliente: 'Cliente Exemplo B',
        aparelho: 'Samsung Galaxy S22',
        defeito: 'Tela frontal estilhaçada sem imagem após queda',
        status: 'Pronto para Retirada',
        percentual: 100,
        dataEntrada: '24/09/2026',
        previsao: '26/09/2026',
        tecnico: 'Técnica Fabiana Ramos',
        laudo: 'Substituição completa do módulo display AMOLED Dynamic original com aro. Aplicada fita de vedação de proteção e realizados testes de biometria ultrassônica e toque multitoque.',
        valor: 'R$ 490,00',
        historico: [
          { data: '24/09 11:00', evento: 'Aparelho recebido para troca de tela' },
          { data: '24/09 11:30', evento: 'Orçamento aprovado presencialmente' },
          { data: '25/09 14:00', evento: 'Instalação do display novo e vedação' },
          { data: '26/09 09:00', evento: 'Testes de carga e sensores 100% aprovados. Pronto para entrega.' }
        ]
      }
    },
    osInput: 'CT-2024-001',
    logged: true,
    notFound: false,
    reparo: null,
    init() {
      this.reparo = this.demos['CT-2024-001'];
    },
    searchOS() {
      const os = this.osInput.trim().toUpperCase();
      const found = this.demos[os];
      this.logged = Boolean(found);
      this.notFound = !found;
      if (found) this.reparo = found;
    }
  }">
    <!-- Search Bar -->
    <div class="card os-search-box">
      <h3>Consultar Ordem de Serviço (OS)</h3>
      <p>Digite o número da sua OS que consta no comprovante de entrega (Ex: <strong>CT-2024-001</strong> ou <strong>CT-2024-002</strong>):</p>
      <p class="demo-notice" role="note">Ambiente de demonstração: os dados exibidos são fictícios. Para o status real do seu aparelho, fale com a equipe pelo WhatsApp.</p>

      <div class="search-form">
        <input
          type="text"
          x-model="osInput"
          @keydown.enter="searchOS()"
          maxlength="20"
          autocomplete="off"
          aria-label="Número da OS"
          class="form-input"
          placeholder="Número da OS (ex: CT-2024-001)"
        />
        <button type="button" @click="searchOS()" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span>Buscar OS</span>
        </button>
      </div>
      <p class="form-error" role="alert" x-show="notFound" x-cloak>OS não encontrada. Confira o número no comprovante ou fale com a equipe pelo WhatsApp.</p>
    </div>

    <!-- Active Repair Dashboard Card -->
    <div class="card os-dashboard" x-show="logged">
      <div class="os-header">
        <div>
          <span class="badge badge-orange" x-text="reparo.id"></span>
          <h2 class="os-device-title" x-text="reparo.aparelho"></h2>
          <span class="os-client-name" x-text="`Cliente: ${reparo.cliente}`"></span>
        </div>
        <div class="os-status-pill">
          <span class="pill-status" 
            :class="{
              'pill-repair': reparo.status === 'Em Reparo',
              'pill-ready': reparo.status === 'Pronto para Retirada',
              'pill-testing': reparo.status === 'Diagnóstico'
            }"
            x-text="reparo.status"
          ></span>
        </div>
      </div>

      <!-- Progress Bar -->
      <div class="os-progress-container">
        <div class="progress-labels">
          <span>Progresso do Serviço</span>
          <strong x-text="`${reparo.percentual}%`"></strong>
        </div>
        <div class="progress-track">
          <div class="progress-fill" :style="`width: ${reparo.percentual}%`"></div>
        </div>
      </div>

      <!-- Dates & Values Grid -->
      <div class="os-meta-grid">
        <div class="os-meta-item">
          <small>Data de Entrada</small>
          <strong x-text="reparo.dataEntrada"></strong>
        </div>
        <div class="os-meta-item">
          <small>Previsão de Entrega</small>
          <strong x-text="reparo.previsao"></strong>
        </div>
        <div class="os-meta-item">
          <small>Técnico Responsável</small>
          <strong x-text="reparo.tecnico"></strong>
        </div>
        <div class="os-meta-item">
          <small>Valor Total do Serviço</small>
          <strong class="highlight-price" x-text="reparo.valor"></strong>
        </div>
      </div>

      <!-- Technical Report -->
      <div class="laudo-box">
        <h4>Laudo Técnico do Laboratório</h4>
        <p x-text="reparo.laudo"></p>
      </div>

      <!-- History log -->
      <div class="history-section">
        <h4>Linha do Tempo de Atualizações</h4>
        <div class="history-list">
          <template x-for="item in reparo.historico" :key="item.data">
            <div class="history-item">
              <span class="hist-time" x-text="item.data"></span>
              <span class="hist-desc" x-text="item.evento"></span>
            </div>
          </template>
        </div>
      </div>

      <div class="os-actions">
        <a href="https://wa.me/5544988424935" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
          <span>Falar com o Técnico no WhatsApp</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .os-search-box {
    margin-bottom: 2rem;
  }

  .os-search-box h3 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .os-search-box p {
    color: var(--ct-text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }

  .search-form {
    display: flex;
    gap: 1rem;
  }

  .os-search-box .demo-notice {
    font-size: 0.85rem;
    border-left: 3px solid var(--ct-orange-500);
    padding-left: 0.75rem;
  }

  .os-search-box .form-error {
    margin-top: 0.75rem;
  }

  .os-dashboard {
    padding: 2.5rem;
  }

  .os-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2rem;
    gap: 1.5rem;
  }

  .os-device-title {
    font-size: 1.6rem;
    margin-top: 0.5rem;
  }

  .os-client-name {
    color: var(--ct-text-muted);
    font-size: 0.95rem;
  }

  .os-progress-container {
    margin-bottom: 2rem;
  }

  .progress-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .progress-track {
    height: 10px;
    background: var(--ct-surface);
    border-radius: var(--ct-radius-full);
    overflow: hidden;
    border: 1px solid var(--ct-border);
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--ct-blue-500), var(--ct-orange-500));
    border-radius: var(--ct-radius-full);
    transition: width 0.4s ease;
  }

  .os-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    background: var(--ct-surface);
    padding: 1.25rem;
    border-radius: var(--ct-radius-sm);
    border: 1px solid var(--ct-border);
    margin-bottom: 2rem;
  }

  .os-meta-item small {
    display: block;
    color: var(--ct-text-muted);
    font-size: 0.8rem;
    margin-bottom: 0.25rem;
  }

  .os-meta-item strong {
    font-size: 0.95rem;
    color: var(--ct-text-main);
  }

  .highlight-price {
    color: var(--ct-orange-400) !important;
  }

  .laudo-box {
    background: rgba(30, 111, 191, 0.08);
    border: 1px solid rgba(30, 111, 191, 0.25);
    border-radius: var(--ct-radius-sm);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .laudo-box h4 {
    color: var(--ct-blue-300);
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .laudo-box p {
    color: var(--ct-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .history-section h4 {
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .history-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-left: 2px solid var(--ct-border);
    padding-left: 1.25rem;
    margin-bottom: 2rem;
  }

  .history-item {
    display: flex;
    flex-direction: column;
  }

  .hist-time {
    font-size: 0.8rem;
    color: var(--ct-orange-400);
    font-weight: 700;
  }

  .hist-desc {
    color: var(--ct-text-main);
    font-size: 0.95rem;
  }

  .pill-repair {
    background: rgba(255, 107, 26, 0.2);
    color: var(--ct-orange-400);
    padding: 0.4rem 0.9rem;
    border-radius: var(--ct-radius-full);
    font-weight: 700;
  }

  .pill-ready {
    background: rgba(20, 184, 122, 0.2);
    color: var(--ct-green-400);
    padding: 0.4rem 0.9rem;
    border-radius: var(--ct-radius-full);
    font-weight: 700;
  }

  .pill-testing {
    background: rgba(30, 111, 191, 0.2);
    color: var(--ct-blue-300);
    padding: 0.4rem 0.9rem;
    border-radius: var(--ct-radius-full);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .os-meta-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .search-form {
      flex-direction: column;
    }
    .os-header {
      flex-direction: column;
    }
  }
</style>
