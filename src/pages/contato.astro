---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Map from '../components/Map.astro';
import { cidadesAtendidasTexto } from '../lib/coleta';

const WHATSAPP = '5544988424935';
---

<BaseLayout 
  title="Contato & Orçamento Rápido | CamargoTech" 
  description="Entre em contato com a CamargoTech. Envie seu pedido de orçamento para conserto de celular, notebook ou computador. Atendimento presencial e online."
  activePage="contato"
>
  <div class="section-head" style="padding-top: 4rem;">
    <span class="badge badge-orange">Canais de Atendimento</span>
    <h1>Fale com a CamargoTech</h1>
    <p>Estamos prontos para diagnosticar seu equipamento e tirar todas as suas dúvidas técnicas.</p>
  </div>

  <section class="container" style="margin-bottom: 5rem;">
    <div class="contact-page-grid">
      <!-- Contact Cards -->
      <div class="contact-details">
        <div class="card detail-card">
          <div class="detail-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/>
            </svg>
          </div>
          <div>
            <h3>WhatsApp Técnico</h3>
            <p>Tire dúvidas e envie fotos do defeito para uma pré-análise imediata.</p>
            <a href="https://wa.me/5544988424935" target="_blank" rel="noopener noreferrer" class="contact-link">
              (44) 98842-4935 →
            </a>
          </div>
        </div>

        <div class="card detail-card">
          <div class="detail-icon icon-blue">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div>
            <h3>E-mail Corporativo</h3>
            <p>Para laudos formais, orçamentos para empresas e faturamento via boleto.</p>
            <a href="mailto:techcamargo@techcamargo.com.br" class="contact-link">
              techcamargo@techcamargo.com.br →
            </a>
          </div>
        </div>

        <div class="card detail-card">
          <div class="detail-icon icon-green">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div>
            <h3>Laboratório Presencial</h3>
            <p>Centro, Paiçandu - PR (CEP 87140-000)</p>
            <span class="hours-tag">Seg a Sex 08:30 às 18:30 | Sáb 09:00 às 13:00</span>
          </div>
        </div>

        <!-- Coleta por motoboy: consulta de CEP no servidor (/api/cep) + regras de src/lib/coleta.ts -->
        <div class="card detail-card cep-calculator" x-data={`{
          cep: '', status: 'idle', endereco: null, cobertura: null, ultimo: '', ctrl: null,
          whatsapp: '${WHATSAPP}', area: '${cidadesAtendidasTexto()}',
          mascara(v) {
            const d = v.replace(/\\D/g, '').slice(0, 8);
            this.cep = d.length > 5 ? d.slice(0, 5) + '-' + d.slice(5) : d;
            if (d.length === 8) this.consultar();
            else if (this.status !== 'idle') { this.status = 'idle'; this.ultimo = ''; }
          },
          async consultar() {
            const d = this.cep.replace(/\\D/g, '');
            if (d.length !== 8) { this.status = 'invalido'; return; }
            if (d === this.ultimo && this.status !== 'erro') return;
            this.ultimo = d;
            this.ctrl?.abort();
            const ctrl = (this.ctrl = new AbortController());
            this.status = 'loading';
            this.endereco = null;
            this.cobertura = null;
            try {
              const res = await fetch('/api/cep/' + d, { signal: ctrl.signal });
              if (res.status === 404 || res.status === 400) { this.status = 'inexistente'; return; }
              if (!res.ok) throw new Error('HTTP ' + res.status);
              const data = await res.json();
              this.endereco = data.endereco;
              this.cobertura = data.cobertura;
              this.status = data.cobertura.atendido ? 'atendido' : 'fora';
            } catch (e) {
              if (e.name !== 'AbortError') this.status = 'erro';
            }
          },
          get enderecoTexto() {
            const e = this.endereco;
            if (!e) return '';
            const rua = [e.logradouro, e.bairro].filter(Boolean).join(', ');
            return (rua ? rua + ' - ' : '') + e.cidade + '/' + e.uf;
          },
          get prazoTexto() {
            const p = this.cobertura?.previsao;
            return p ? (p.hoje ? 'Coleta hoje' : 'Coleta ' + p.rotulo) : '';
          },
          get taxaTexto() {
            const t = this.cobertura?.taxaCentavos ?? 0;
            return t === 0 ? 'Coleta grátis' : 'Taxa de coleta: ' + (t / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
          },
          linkWhats(texto) { return 'https://wa.me/' + this.whatsapp + '?text=' + encodeURIComponent(texto); },
          get whatsColeta() {
            return this.linkWhats('Olá! Quero solicitar a coleta por motoboy. CEP ' + this.cep + ' (' + this.enderecoTexto + '). Previsão: ' + this.prazoTexto.toLowerCase() + '.');
          },
          get whatsCorreios() {
            return this.linkWhats('Olá! Moro em ' + (this.endereco ? this.endereco.cidade + '/' + this.endereco.uf : 'outra cidade') + ' (CEP ' + this.cep + ') e gostaria de enviar meu aparelho pelos Correios para conserto.');
          },
          get linkOs() { return '/area-cliente/nova?atendimento=coleta&cep=' + this.cep.replace(/\\D/g, ''); }
        }`}>
          <h3>Simular Coleta por Motoboy</h3>
          <p>Digite seu CEP para ver se buscamos e entregamos o aparelho na sua casa. Atendemos {cidadesAtendidasTexto()}.</p>
          <form class="cep-input-group" @submit.prevent="consultar()">
            <label for="cep-coleta" class="sr-only">CEP</label>
            <input
              id="cep-coleta"
              type="text"
              inputmode="numeric"
              autocomplete="postal-code"
              :value="cep"
              @input="mascara($event.target.value); $event.target.value = cep"
              class="form-input"
              placeholder="Digite seu CEP (Ex: 87140-000)"
              maxlength="9"
            />
            <button type="submit" class="btn btn-outline" :disabled="status === 'loading'">Consultar</button>
          </form>

          <div class="cep-result-area" aria-live="polite">
            <p x-show="status === 'loading'" class="cep-result" x-cloak>Consultando CEP...</p>

            <div x-show="status === 'atendido'" class="cep-result cep-success" x-cloak>
              <span>✓ Atendemos seu endereço</span>
              <strong x-text="enderecoTexto"></strong>
              <ul class="cep-facts">
                <li x-text="taxaTexto"></li>
                <li x-text="prazoTexto"></li>
              </ul>
              <small class="cep-note">Pedidos até 15h (sábado até 11h) são coletados no mesmo dia.</small>
              <div class="cep-actions">
                <a :href="whatsColeta" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">Solicitar coleta pelo WhatsApp</a>
                <a :href="linkOs" class="btn btn-outline">Abrir OS com coleta</a>
              </div>
            </div>

            <div x-show="status === 'fora'" class="cep-result cep-warning" x-cloak>
              <span>Ainda não fazemos coleta por motoboy em <strong x-text="endereco ? endereco.cidade + '/' + endereco.uf : ''"></strong>.</span>
              <p>Você pode enviar o aparelho pelos <strong>Correios ou transportadora</strong>: combinamos a embalagem e o envio pelo WhatsApp.</p>
              <div class="cep-actions">
                <a :href="whatsCorreios" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">Combinar envio pelo WhatsApp</a>
              </div>
            </div>

            <p x-show="status === 'inexistente' || status === 'invalido'" class="cep-result cep-error" x-cloak>
              CEP não encontrado. Confira os 8 dígitos e tente novamente.
            </p>

            <div x-show="status === 'erro'" class="cep-result cep-error" x-cloak>
              <p>Não conseguimos consultar o CEP agora. Tente novamente em instantes ou fale com a gente.</p>
              <div class="cep-actions">
                <button type="button" class="btn btn-outline" @click="consultar()">Tentar novamente</button>
                <a :href="linkWhats('Olá! Quero saber se vocês fazem coleta no CEP ' + cep + '.')" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">WhatsApp</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div>
        <ContactForm />
      </div>
    </div>
  </section>

  <!-- Location Map -->
  <Map />
</BaseLayout>

<style>
  .contact-page-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 3.5rem;
    align-items: start;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .detail-card {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .detail-icon {
    width: 50px;
    height: 50px;
    border-radius: var(--ct-radius-md);
    background: rgba(37, 211, 102, 0.15);
    color: #25D366;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .icon-blue {
    background: rgba(30, 111, 191, 0.15);
    color: var(--ct-blue-300);
  }

  .icon-green {
    background: rgba(20, 184, 122, 0.15);
    color: var(--ct-green-400);
  }

  .detail-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.25rem;
    color: var(--ct-text-main);
  }

  .detail-card p {
    color: var(--ct-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

  .contact-link {
    color: var(--ct-orange-400);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .hours-tag {
    font-size: 0.85rem;
    color: var(--ct-text-muted);
    font-weight: 600;
  }

  .cep-calculator {
    flex-direction: column;
    gap: 0.75rem;
  }

  .cep-input-group {
    display: flex;
    gap: 0.75rem;
    width: 100%;
  }

  .cep-result {
    font-size: 0.88rem;
    margin-top: 0.5rem;
  }

  .cep-success {
    color: var(--ct-green-400);
  }

  .cep-success strong {
    display: block;
    color: var(--ct-text-main);
  }

  .cep-error {
    color: var(--ct-error);
  }

  .cep-warning {
    color: var(--ct-orange-400);
  }

  .cep-warning p,
  .cep-error p {
    color: var(--ct-text-muted);
    margin-top: 0.35rem;
  }

  .cep-warning strong {
    color: var(--ct-text-main);
  }

  .cep-facts {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cep-facts li {
    background: rgba(20, 184, 122, 0.15);
    color: var(--ct-green-400);
    border-radius: var(--ct-radius-full);
    padding: 0.2rem 0.7rem;
    font-weight: 700;
    font-size: 0.82rem;
  }

  .cep-note {
    display: block;
    color: var(--ct-text-muted);
  }

  .cep-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .cep-actions .btn {
    font-size: 0.88rem;
    padding: 0.55rem 0.9rem;
  }

  @media (max-width: 900px) {
    .contact-page-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
