{
  "name": "camargotech",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "CamargoTech - Assistência Técnica Especializada em Celulares, Notebooks e PCs",
  "scripts": {
    "dev": "astro dev --port 4321",
    "dev:host": "astro dev --host 0.0.0.0 --port 4321",
    "start": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "check": "astro check",
    "test": "node --env-file-if-exists=.env.local --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.11",
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.1.0",
    "alpinejs": "^3.14.8",
    "astro": "^7.3.5",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/alpinejs": "^3.13.11",
    "@types/node": "^24.19.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
